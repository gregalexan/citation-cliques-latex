INCLUDE CREATE author_behavior_metrics.sql
INCLUDE CREATE author_behavior_metrics.sql

BEGIN CREATE
CREATE TABLE behavior_result AS
SELECT
    orcid,
    subject,
    total_outgoing_citations,
    nonself_outgoing_citations,
    self_citation_rate,
    coauthor_citation_rate,
    coauthor_citation_rate_same_year
FROM rolap.author_behavior_metrics
ORDER BY orcid;
END

BEGIN RESULT
behavior_result:
orcid	subject	total_outgoing_citations	nonself_outgoing_citations	self_citation_rate	coauthor_citation_rate	coauthor_citation_rate_same_year
o1	Biology	4.0	2.0	0.5	0.5	1.0
o2	Biology	0.0	0.0	null	null	null
o3	Biology	5.0	0.0	1.0	null	null
END
