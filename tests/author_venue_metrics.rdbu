INCLUDE CREATE author_venue_metrics.sql
INCLUDE CREATE author_venue_metrics.sql

BEGIN CREATE
CREATE TABLE venue_result AS
SELECT orcid, subject, total_refs, same_journal_refs, journal_endogamy_rate
FROM rolap.author_venue_metrics
ORDER BY subject;
END

BEGIN RESULT
venue_result:
orcid	subject	total_refs	same_journal_refs	journal_endogamy_rate
a	S	2	1	0.5
a	T	1	1	1.0
END
