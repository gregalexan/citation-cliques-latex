BEGIN SETUP
work_authors:
work_id	orcid
1	o1
2	o1
3	o1
4	o2
5	o2
6	o2

rolap.author_works_master:
orcid	subject	eigenfactor_score	citations
o1	Bio	0.10	0
o1	Bio	0.15	0
o1	Bio	0.05	0
o2	Bio	0.90	0
o2	Bio	0.95	0
