INCLUDE CREATE author_profiles.sql

BEGIN CREATE
CREATE TABLE profile_result AS
SELECT orcid, subject, REPLACE(author_tier, ' ', '_') AS author_tier
FROM rolap.author_profiles
ORDER BY orcid;
END

BEGIN RESULT
profile_result:
orcid	subject	author_tier
o1	Bio	Bottom_Tier
o2	Bio	Top_Tier
END
